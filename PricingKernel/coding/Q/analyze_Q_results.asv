% filename: analyze_Q_SVCJ_result.m
% written by Chin HSU on 2026/05/13
% Descriptions: to analyze Q parameters just estimated

function analyze_Q_results(model, mc_size)

clc;
close all;

%% ===== Model Setting =====

switch model

    case 'BS'

        result_file = 'daily_BS_calibration.csv';

        rmse_name = 'RMSE_BS';

        param_names = { ...
            'sigma_BS' ...
        };

    case 'SV'

        result_file = 'daily_SV_calibration.csv';

        rmse_name = 'RMSE_SV';

        param_names = { ...
            'mu', ...
            'rho', ...
            'alpha', ...
            'beta', ...
            'V0', ...
            'sigma_v' ...
        };

    case 'SVJ'

        result_file = 'daily_SVJ_calibration.csv';

        rmse_name = 'RMSE_SVJ';

        param_names = { ...
            'mu', ...
            'rho', ...
            'alpha', ...
            'beta', ...
            'V0', ...
            'sigma_v', ...
            'lambda', ...
            'mu_y', ...
            'sigma_y' ...
        };

    case 'SVCJ'

        result_file = 'daily_SVCJ_calibration.csv';

        rmse_name = 'RMSE_SVCJ';

        param_names = { ...
            'mu', ...
            'rho', ...
            'alpha', ...
            'beta', ...
            'V0', ...
            'sigma_v', ...
            'lambda', ...
            'mu_y', ...
            'rho_j', ...
            'sigma_y', ...
            'mu_v' ...
        };

    otherwise

        error('Unknown model.');

end

%% ===== Load Result =====

folder_name = sprintf('%s_calibration_%dpaths', model, mc_size);

input_file = fullfile(folder_name, result_file);

result = readtable(input_file);

%% ===== Analysis Folder =====

analysis_folder = fullfile(folder_name, 'Q_measure_analysis');

if ~exist(analysis_folder, 'dir')
    mkdir(analysis_folder);
end

%% ===== Summary Statistics =====

summary_table = table;

for j = 1:length(param_names)

    name = param_names{j};

    x = result.(name);

    summary_table.Parameter(j,1) = string(name);

    summary_table.Mean(j,1) = mean(x,'omitnan');

    summary_table.Std(j,1) = std(x,'omitnan');

    summary_table.Min(j,1) = min(x,[],'omitnan');

    summary_table.Q25(j,1) = quantile(x,0.25);

    summary_table.Median(j,1) = median(x,'omitnan');

    summary_table.Q75(j,1) = quantile(x,0.75);

    summary_table.Max(j,1) = max(x,[],'omitnan');

end

summary_filename = sprintf('%s_Q_parameter_summary_%dpath.csv', model);

writetable(summary_table, ...
    fullfile(analysis_folder, summary_filename));

disp(summary_table);

%% ===== Add kappa and theta for SV-type models =====

if ismember(model, {'SV','SVJ','SVCJ'})

    result.kappa = 1 - result.beta;

    result.theta = result.alpha ./ result.kappa;

    param_names = [param_names, {'kappa','theta'}];

end

%% ===== Time Series Plot =====

for j = 1:length(param_names)

    name = param_names{j};

    fig = figure;

    plot(result.date, result.(name), '-o', ...
        'LineWidth', 1.2);

    xlabel('Date');

    ylabel(name, 'Interpreter', 'none');

    title(sprintf('%s Q-measure parameter: %s', ...
        model, name), ...
        'Interpreter', 'none');

    grid on;

    set(gcf,'color','none');
    set(gca,'color','none');

    export_fig( ...
        fullfile(analysis_folder, ...
        sprintf('%s_Q_parameter_%s', model, name)), ...
        '-png', '-transparent', '-r300', '-opengl');

    close(fig);

end

%% ===== Histogram =====

for j = 1:length(param_names)

    name = param_names{j};

    fig = figure;

    histogram(result.(name), 20);

    xlabel(name, 'Interpreter', 'none');

    ylabel('Frequency');

    title(sprintf('Histogram of %s %s', ...
        model, name), ...
        'Interpreter', 'none');

    grid on;

    set(gcf,'color','none');
    set(gca,'color','none');

    export_fig( ...
        fullfile(analysis_folder, ...
        sprintf('Histogram_%s_%s', model, name)), ...
        '-png', '-transparent', '-r300', '-opengl');

    close(fig);

end

%% ===== RMSE Time Series =====

fig = figure;

plot(result.date, result.(rmse_name), '-o', ...
    'LineWidth', 1.2);

xlabel('Date');

ylabel(rmse_name, 'Interpreter', 'none');

title(sprintf('%s calibration RMSE', model));

grid on;

set(gcf,'color','none');
set(gca,'color','none');

export_fig( ...
    fullfile(analysis_folder, ...
    sprintf('%s_RMSE_timeseries', model)), ...
    '-png', '-transparent', '-r300', '-opengl');

close(fig);

%% ===== Correlation Matrix =====

if length(param_names) >= 2

    X = result{:, param_names};

    corr_mat = corr(X, 'Rows', 'pairwise');

    corr_table = array2table(corr_mat, ...
        'VariableNames', param_names, ...
        'RowNames', param_names);

    corr_filename = sprintf('%s_Q_parameter_correlation.csv', model);

    writetable(corr_table, ...
        fullfile(analysis_folder, corr_filename), ...
        'WriteRowNames', true);

    fig = figure;

    imagesc(corr_mat);

    colorbar;

    axis equal tight;

    xticks(1:length(param_names));
    yticks(1:length(param_names));

    xticklabels(param_names);
    yticklabels(param_names);

    xtickangle(45);

    title(sprintf('%s parameter correlation matrix', model));

    set(gcf,'color','none');
    set(gca,'color','none');

    export_fig( ...
        fullfile(analysis_folder, ...
        sprintf('%s_parameter_correlation_matrix', model)), ...
        '-png', '-transparent', '-r300', '-opengl');

    close(fig);

end

%% ===== Diagnostics =====

diag_table = table;

diag_table.Parameter = string(param_names(:));

diag_table.Num_NaN = zeros(length(param_names),1);

diag_table.Num_Inf = zeros(length(param_names),1);

for j = 1:length(param_names)

    name = param_names{j};

    x = result.(name);

    diag_table.Num_NaN(j) = sum(isnan(x));

    diag_table.Num_Inf(j) = sum(isinf(x));

end

diag_filename = sprintf('%s_parameter_diagnostics.csv', model);

writetable(diag_table, ...
    fullfile(analysis_folder, diag_filename));

disp(diag_table);

fprintf('\n%s Q-measure analysis finished.\n', model);

end